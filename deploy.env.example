# Copy to deploy.env and fill in. deploy.env is ignored by git.
DEPLOY_HOST = onesimus.io
DEPLOY_USER =
# Web root on the server, absolute, with trailing slash. rsync --delete empties it first.
DEPLOY_PATH =
# Optional: private key to use. Empty = ssh default keys.
DEPLOY_KEY  =
DEPLOY_PORT = 22
# Set to 1 to force IPv4 (ssh -4).
DEPLOY_IPV4 =
